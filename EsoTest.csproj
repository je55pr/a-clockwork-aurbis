<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>EsoTest</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the standalone simulation, tools and their tests out of the Godot assembly. -->
    <Compile Remove="tools/**/*.cs;src/AClockworkAurbis.Simulation/**/*.cs;tests/SimulationTests/**/*.cs;tests/SettlementTests/**/*.cs" />
  </ItemGroup>
</Project>
